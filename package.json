{
  "name": "femboy-launcher",
  "productName": "Femboy Launcher",
  "version": "0.10.2",
  "description": "Minecraft-лаунчер с бойкиссером: сборки, моды и модпаки с Modrinth/CurseForge, вход через Microsoft, Ely.by и оффлайн",
  "author": "Femboy Launcher",
  "main": "src/main.js",
  "updates": {
    "yandex": "https://disk.yandex.ru/d/lVJoM6m6kR5sxQ",
    "github": "EternalPorter16/femboy-launcher",
    "url": "https://downloads.femboylauncher.ru/",
    "downloadPage": "https://femboylauncher.ru/#download"
  },
  "discord": {
    "clientId": "1564382093419614328",
    "buttons": []
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/*.test.js\"",
    "test:electron": "node tests/electron/run.js",
    "test:electron-node": "node tests/electron-node.js",
    "test:ui": "node tests/ui/run.js",
    "dist": "electron-builder --win",
    "dist:setup": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "electron-updater": "^6.8.11",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5",
    "skinview3d": "^3.4.2",
    "tar": "^7.4.3",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1164.0",
    "basic-ftp": "6.2.6",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.femboy.launcher",
    "productName": "Femboy Launcher",
    "copyright": "Femboy Launcher",
    "electronDist": "node_modules/electron/dist",
    "electronLanguages": [
      "ru",
      "en-US"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "EternalPorter16",
        "repo": "femboy-launcher",
        "releaseType": "draft"
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.d.ts",
      "!**/{README,CHANGELOG,readme,changelog}*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "fileAssociations": [
      {
        "ext": "mrpack",
        "name": "Модпак Modrinth",
        "description": "Модпак Modrinth (.mrpack)",
        "role": "Viewer"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Femboy Launcher",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "ru_RU",
        "en_US"
      ],
      "language": "1049",
      "artifactName": "FemboyLauncher-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "FemboyLauncher-Portable-${version}.${ext}"
    }
  }
}
