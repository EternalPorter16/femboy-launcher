---
// Настоящий скриншот лаунчера в рамке; по нажатию открывается крупно (лайтбокс в src/scripts/site.js).
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  file: string;
  alt: string;
  caption: string;
  group: string;
  sizes: string;
  eager?: boolean;
}
const { file, alt, caption, group, sizes, eager = false } = Astro.props;
const all = import.meta.glob<{ default: ImageMetadata }>('../assets/screenshots/*.png', { eager: true });
const src = all[`../assets/screenshots/${file}.png`]?.default;
if (!src) throw new Error(`Нет скриншота src/assets/screenshots/${file}.png`);
const full = await getImage({ src, width: 2000, format: 'webp', quality: 82 });
---

<button class="shot-btn" type="button" data-lb={group} data-full={full.src} data-caption={caption} data-alt={alt} aria-label={`Открыть крупно: ${caption}`}>
  <span class="frame">
    <Image src={src} widths={[400, 640, 960, 1280]} sizes={sizes} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
  </span>
</button>
