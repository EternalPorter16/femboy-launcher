---
// Вопросы и ответы. Ответы сверены с README и кодом лаунчера 0.10.0.
const faq: { id: string; q: string; a: string[] }[] = [
  {
    id: 'faq-windows',
    q: 'На каких Windows работает лаунчер?',
    a: [
      'На <strong>Windows 10 и 11, 64-битных</strong>. Windows 7, 8 и 8.1 не поддерживаются: на них не запускается движок Electron, на котором собран лаунчер. Для macOS и Linux версий нет.',
    ],
  },
  {
    id: 'faq-java',
    q: 'Нужно ли ставить Java?',
    a: [
      'Нет. Лаунчер сам скачает подходящую Java (8, 17, 21 и другие) для версии игры. Если хочешь свою, в настройках есть «Найти Java» и выбор файла, а рядом видно, подойдёт ли она игре.',
    ],
  },
  {
    id: 'faq-difference',
    q: 'Чем установщик отличается от Portable?',
    a: [
      '<strong>Установщик</strong> ставит лаунчер как обычную программу: ярлыки, удаление через «Приложения», автообновление и открытие файлов .mrpack двойным щелчком. Сборки и миры лежат в профиле Windows.',
      '<strong>Portable</strong> — один файл без установки. Все данные он хранит в папке <code>data</code> рядом с собой, поэтому его удобно носить на флешке. Сам он не обновляется, новую версию нужно скачать.',
    ],
  },
  {
    id: 'faq-updates',
    q: 'Как лаунчер обновляется?',
    a: [
      'Версия с установщиком проверяет обновления при запуске и раз в 2 часа. Новая версия скачивается в фоне, лаунчер показывает «Что нового» и обновляется по кнопке или когда ты его закроешь. Пока идёт игра, перезапуск не предлагается.',
      'Portable только сообщает, что вышла новая версия. Скачай её здесь и положи рядом со старой папкой <code>data</code>. Сборки, миры и аккаунты обновление не трогает.',
      'Старая версия показывает 429 / Too Many Requests от Яндекс.Диска? <a href="#help-update-429">Как обновить её вручную и сохранить сборки</a>.',
    ],
  },
  {
    id: 'faq-smartscreen',
    q: 'Windows пишет «Windows защитил ваш компьютер». Что делать?',
    a: [
      'У лаунчера пока нет цифровой подписи. Как проверить скачанный файл и действовать при предупреждении, описано в разделе <a href="#help">«Не получается запустить?»</a>.',
    ],
  },
  {
    id: 'faq-migrate',
    q: 'Можно перенести сборки из TLauncher и других лаунчеров?',
    a: [
      'Да. Лаунчер сам ищет Legacy Launcher (TL Legacy), TLauncher, официальный лаунчер, Prism, PolyMC, MultiMC, CurseForge, Modrinth App, ATLauncher и GDLauncher, в том числе портативные копии, и предлагает перенести сборки, миры, моды и ресурспаки. Другие лаунчеры он узнаёт по устройству папок.',
      'Старые лаунчеры при этом не меняются. Импорт тоже есть: файлы <code>.mrpack</code>, zip-архивы CurseForge и сборки Prism и MultiMC.',
    ],
  },
  {
    id: 'faq-accounts',
    q: 'Какие есть способы входа?',
    a: [
      '<strong>Microsoft</strong> — для лицензии и онлайн-серверов, откроется окно входа Microsoft. Скин и плащ можно менять прямо в лаунчере.',
      '<strong>Ely.by</strong> — аккаунт на ely.by со своими скинами. Лаунчер не хранит пароль, только зашифрованный средствами Windows токен.',
      '<strong>Оффлайн</strong> — просто ник для одиночной игры и серверов без проверки лицензии.',
    ],
  },
  {
    id: 'faq-offline',
    q: 'Пустит ли оффлайн-профиль на любой сервер?',
    a: [
      'Нет. Серверы, которые проверяют лицензию, оффлайн-профиль не пустят — это решает сервер, а не лаунчер. Для них нужен вход через Microsoft. С оффлайн-профилем доступны одиночная игра, игра с друзьями по сети и серверы, где проверка лицензии выключена.',
    ],
  },
  {
    id: 'faq-curseforge',
    q: 'Работает ли CurseForge?',
    a: [
      'Основной каталог — Modrinth, ему ключи не нужны. CurseForge подключается личным бесплатным API-ключом: Настройки → CurseForge, а ключ берётся на console.curseforge.com.',
      'Обычные ключи не дают права на <strong>поиск</strong>: CurseForge открывает его только одобренным лаунчерам. Поэтому мод или модпак с CurseForge ставится по Project ID со страницы мода. Моды, авторы которых запретили скачивание из сторонних лаунчеров, лаунчер не качает, а даёт на них ссылку.',
    ],
  },
  {
    id: 'faq-uninstall',
    q: 'Что будет с мирами, если удалить лаунчер?',
    a: [
      'При удалении через «Приложения» сборки, миры и аккаунты остаются на месте. Если поставить лаунчер снова, он их подхватит.',
    ],
  },
  {
    id: 'faq-official',
    q: 'Это официальный лаунчер Minecraft?',
    a: [
      'Нет, это независимый проект, он не связан с Mojang Studios и Microsoft. Для игры по лицензии нужна купленная Minecraft: Java Edition на аккаунте Microsoft.',
    ],
  },
  {
    id: 'faq-english',
    q: 'Есть ли английский язык?',
    a: ['Да: Настройки → Оформление → Язык. По умолчанию интерфейс русский.'],
  },
];
---

<section class="section" id="faq" aria-labelledby="faq-title">
  <div class="wrap faq-layout">
    <div class="section-head">
      <h2 id="faq-title">Вопросы</h2>
      <p>Коротко о том, что чаще всего спрашивают перед установкой.</p>
    </div>
    <div class="faq">
      {
        faq.map((f) => (
          <details id={f.id}>
            <summary>{f.q}</summary>
            <div class="answer">
              {f.a.map((p) => (
                <p set:html={p} />
              ))}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
