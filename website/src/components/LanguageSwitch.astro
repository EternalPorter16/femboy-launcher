---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const path = Astro.url.pathname.slice(base.length);
const english = path === 'en' || path.startsWith('en/');
const relative = english ? path.replace(/^en\/?/, '') : path;
const russianUrl = base + relative;
const englishUrl = base + 'en/' + relative;
---
<nav class="language-switch" aria-label={english ? 'Website language' : 'Язык сайта'}>
  <a href={russianUrl} lang="ru" hreflang="ru" data-language-link="ru" aria-current={!english ? 'true' : undefined} aria-label="Русский">RU</a>
  <span aria-hidden="true">/</span>
  <a href={englishUrl} lang="en" hreflang="en" data-language-link="en" aria-current={english ? 'true' : undefined} aria-label="English">EN</a>
</nav>
<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-language-link]').forEach((link) => {
    link.hash = location.hash;
    link.search = location.search;
  });
  window.addEventListener('hashchange', () => {
    document.querySelectorAll<HTMLAnchorElement>('[data-language-link]').forEach((link) => { link.hash = location.hash; });
  });
</script>
