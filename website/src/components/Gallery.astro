---
import { gallery } from '../data/content.js';
import Shot from './Shot.astro';
import Icon from './Icon.astro';
---

<section class="section" id="gallery" aria-labelledby="gallery-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="gallery-title">Настоящий интерфейс</h2>
      <p>Скриншоты самого лаунчера, без дорисовок. Нажми на любой, чтобы рассмотреть поближе.</p>
    </div>
    <ul class="gallery">
      {
        gallery.map((g) => (
          <li>
            <figure>
              <Shot file={g.file} alt={g.caption} caption={g.caption} group="gallery" sizes="(max-width: 700px) calc(100vw - 32px), (max-width: 1100px) 45vw, 380px" />
              <figcaption>{g.caption}</figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<dialog class="lightbox" id="lightbox" aria-labelledby="lb-caption">
  <div class="lb-stage">
    <img id="lb-img" src="data:," alt="" width="2000" height="1279" />
    <button class="lb-btn lb-close" type="button" data-lb-close aria-label="Закрыть (Escape)"><Icon name="close" /></button>
  </div>
  <div class="lb-bar">
    <p class="lb-caption" id="lb-caption"></p>
    <span class="lb-count" id="lb-count" aria-live="polite"></span>
    <div class="lb-nav">
      <button class="lb-btn" type="button" data-lb-prev aria-label="Предыдущий скриншот"><Icon name="prev" /></button>
      <button class="lb-btn" type="button" data-lb-next aria-label="Следующий скриншот"><Icon name="next" /></button>
    </div>
  </div>
</dialog>
