---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import releases from '../data/releases.json';
import config from '../config/downloads.json';
import { resolveDownloads, parseDate } from '../lib/downloads.js';

const { version } = resolveDownloads(config);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const releaseId = (v: string) => `release-${v.replace(/\./g, '-')}`;
---

<Base title="История версий — Femboy Launcher" description="Что менялось в Femboy Launcher: новые возможности, улучшения и исправления в выпусках лаунчера.">
  <Header />
  <main id="main" class="releases-page">
    <div class="wrap">
      <div class="releases-intro">
        <a class="releases-back" href={base}><Icon name="prev" />На главную</a>
        <h1>История версий</h1>
        <p>Как меняется лаунчер: новые возможности, улучшения и исправления из записей «Что нового».</p>
        <a class="btn btn-primary" href={`${base}#download`}><Icon name="download" />Скачать {version || 'лаунчер'}</a>
      </div>
      <div class="releases-layout">
        <nav class="release-nav" aria-label="Быстрый переход к версии">
          <h2>Все версии</h2>
          <ul>{releases.map((release) => <li><a class:list={{ 'is-current': release.version === version }} href={`#${releaseId(release.version)}`}>{release.version}</a></li>)}</ul>
        </nav>
        <div class="release-list">
          {releases.map((release) => {
            const date = parseDate(release.date);
            return (
              <details class="release-card" id={releaseId(release.version)} open={release.version === version}>
                <summary>
                  <span class="release-heading"><h2>{release.version}</h2>{release.version === version && <span class="badge">Текущая</span>}</span>
                  {date && <time datetime={date.iso}>{date.label}</time>}
                </summary>
                {release.items.length > 0 ? (
                  <ul class="release-items">
                    {release.items.map((item) => <li><span class="release-item-icon" aria-hidden="true">{item.icon}</span><div><h3>{item.title}</h3><p>{item.text}</p></div></li>)}
                  </ul>
                ) : <p class="release-empty">Подробные заметки об этом выпуске не сохранились.</p>}
              </details>
            );
          })}
        </div>
      </div>
    </div>
  </main>
  <Footer />
  <script src="../scripts/site.js"></script>
  <script>
    function openLinkedRelease() {
      let id;
      try { id = decodeURIComponent(location.hash.slice(1)); } catch { return; }
      const card = document.getElementById(id);
      if (card instanceof HTMLDetailsElement && card.classList.contains('release-card')) card.open = true;
    }
    openLinkedRelease();
    window.addEventListener('hashchange', openLinkedRelease);
  </script>
</Base>
