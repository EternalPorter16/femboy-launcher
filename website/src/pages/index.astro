---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Overview from '../components/Overview.astro';
import Features from '../components/Features.astro';
import Gallery from '../components/Gallery.astro';
import Themes from '../components/Themes.astro';
import Start from '../components/Start.astro';
import Download from '../components/Download.astro';
import Help from '../components/Help.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import config from '../config/downloads.json';
import { resolveDownloads } from '../lib/downloads.js';

const { version } = resolveDownloads(config);
---

<Base>
  <Header />
  <main id="main">
    <Hero version={version} />
    <Overview />
    <Features />
    <Gallery />
    <Themes />
    <Start />
    <Download />
    <Help />
    <Faq />
  </main>
  <Footer />
  <script src="../scripts/site.js"></script>
</Base>
