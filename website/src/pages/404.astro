---
import Base from '../layouts/Base.astro';
import { catSvg } from '../lib/cat.js';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Base title="Страница не найдена — Femboy Launcher" noindex>
  <main id="main" class="section">
    <div class="wrap" style="display:grid;gap:20px;justify-items:start;max-width:40rem">
      <div style="width:120px" aria-hidden="true" set:html={catSvg()} />
      <h1 style="font-size:clamp(2rem,1.4rem + 3vw,3.2rem)">Такой страницы нет</h1>
      <p style="color:var(--muted)">Возможно, ссылка устарела. Всё главное, в том числе скачивание, на первой странице.</p>
      <a class="btn btn-primary" href={base}>На главную</a>
    </div>
  </main>
</Base>
