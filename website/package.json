{
  "name": "femboy-launcher-website",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Сайт Femboy Launcher: статическая страница с описанием и скачиванием",
  "scripts": {
    "dev": "astro dev",
    "build": "node --test \"tests/*.test.js\" && astro build",
    "preview": "astro preview",
    "sync:release": "node ../build/website-release.js dist-release",
    "check:config": "node --test \"tests/*.test.js\"",
    "icons": "node scripts/make-icons.mjs"
  },
  "engines": {
    "node": ">=20.3"
  },
  "dependencies": {
    "astro": "5.18.2",
    "sharp": "0.34.5",
    "parse5": "7.3.0"
  }
}
